PORT=5000
MONGODB_URI=mongodb://localhost:27017/hr-outreach
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GROQ_API_KEY=your_groq_api_key
DAILY_SEND_LIMIT=20
GROQ_BATCH_DELAY_MS=1500

# Cron jobs — set to "true" to enable scheduled automation
ENABLE_CRON=false
# Cron schedule for daily draft generation (default: 9:00am every day)
DAILY_DRAFT_CRON=0 9 * * *
# Cron schedule for follow-up job (default: 9:30am every day)
FOLLOWUP_CRON=30 9 * * *
# Cron schedule for reply inbox polling (default: every 30 minutes)
REPLY_POLL_CRON=*/30 * * * *
# How many hours back to look on the first poll run (before last_poll_at is set)
REPLY_POLL_LOOKBACK_HOURS=48
# How many days after sending before a follow-up is due
FOLLOWUP_DAYS=5
# Maximum number of follow-ups per contact
MAX_FOLLOWUPS=2
#
#
#Part 1: Generate Google OAuth Client ID & Client Secret
# Step 1: Open Google Cloud Console
# Go to Google Cloud Console.
# Log in with the Gmail account you want to send outreach emails from.
# Select an existing project or click Select a Project → New Project, name it HR-Outreach-Agent, and click Create.
# Step 2: Enable the Gmail API
# In the left navigation menu, go to APIs & Services → Library.
# Search for Gmail API.
# Click on Gmail API and click Enable.
# Step 3: Configure OAuth Consent Screen
# Go to APIs & Services → OAuth consent screen.
# Select User Type: External, then click Create.
# Fill in the required fields:
# App name: HR Outreach Agent
# User support email: Your email address
# Developer contact information: Your email address
# Click Save and Continue.
# On the Scopes page, click Add or Remove Scopes, search for https://mail.google.com/ or https://www.googleapis.com/auth/gmail.send, check the box, and click Update → Save and Continue.
# On the Test users page, click + Add Users, enter your Gmail address (e.g., utkarshshukla1007@gmail.com), and click Add → Save and Continue.
# Step 4: Create Credentials (Client ID & Client Secret)
# Go to APIs & Services → Credentials.
# Click + Create Credentials → OAuth client ID.
# Application type: Select Web application.
# Name: HR Outreach Web Client.
# Under Authorized redirect URIs, click + Add URI and add:
# text
# https://developers.google.com/oauthplayground
# Click Create.
# A popup will display your Client ID and Client Secret. Copy both values!
# Part 2: Generate the Gmail Refresh Token
# Step 1: Open Google OAuth 2.0 Playground
# Go to Google OAuth 2.0 Playground.
# Step 2: Configure Your Custom Credentials
# Click the Gear icon (⚙️) in the top right corner of the page to open OAuth 2.0 Configuration settings.
# Check the box for Use your own OAuth credentials.
# Paste your OAuth Client ID and OAuth Client Secret (from Part 1, Step 4).
# Step 3: Authorize Gmail Scopes
# On the left panel under Step 1: Select & authorize APIs:
# Scroll down to Gmail API v1.
# Expand it and check: https://mail.google.com/ (or type https://mail.google.com/ into the text box).
# Click the blue Authorize APIs button.
# Select your Google account and click Continue (if warned about unverified app) → Click Allow to grant permissions.
# Step 4: Exchange Authorization Code for Refresh Token
# You will be redirected back to the OAuth Playground under Step 2: Exchange authorization code for tokens.
# Click the blue Exchange authorization code for tokens button.
# Under the response, locate refresh_token. Copy this code string!
# Part 3: Update backend/.env
# Open your backend/.env file and update the following keys:

# env
# GMAIL_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your_client_secret_here
# GMAIL_REFRESH_TOKEN=1//your_generated_refresh_token_here
# Restart your backend server:

#bash
#npm run dev